{
  "name": "sts-path-generator",
  "version": "0.1.0",
  "description": "A fast, rule-faithful reimplementation of Slay the Spire II's act map generator, with path analysis and constraint search.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker-entry.d.ts",
      "import": "./dist/worker-entry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node bench/bench.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
